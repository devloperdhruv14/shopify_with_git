{{ 'availability-section.css' | asset_url | stylesheet_tag }}
{% style %}
    /*====== section padding ========*/
    #section--{{ section.id }} {
       padding-top: {{ section.settings.padding_top }}px;
       padding-bottom: {{ section.settings.padding_bottom }}px;
       color:{{ section.settings.text_color}};
     }

     @media screen and (max-width: 767px) {
       #section--{{ section.id }} {
         padding-top: {{ section.settings.mobile_padding_top }}px;
         padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
       }
     }

  #section--{{ section.id }} .section_title,
  #section--{{ section.id }} .section_info_text{
      color:{{ section.settings.text_color}};
  }
{% endstyle %}

<section id="section--{{ section.id }}" class="availability_sec">
  <div class="container">
    <div class="row">
        <div class="col-12">
          <div class="availability_text">
            {% if section.settings.section_heading != blank %}
              <h2 class="section_title">{{ section.settings.section_heading }}</h2>
            {% endif %}
            {% if section.settings.info_text != blank %}
              <div class="section_info_text">{{ section.settings.info_text }}</div>
            {% endif %}
            {% if section.settings.button_url != blank %}
              <div class="badge">{{ section.settings.button_text }}</div>
            {% endif %}
          </div>
        </div>
      </div>
  </div>
</section>

{% schema %}
  {
  "name": "Availability section",
  "settings": [
      {
        "type": "color_background",
        "id": "section_bg_color",
        "label": "Section bg color"
      },
      {
        "type": "color_background",
        "id": "text_color",
        "label": "Text color"
      },
      {
        "type": "text",
        "id": "section_heading",
        "label": "Section heading"
      },
      {
        "type": "richtext",
        "id": "info_text",
        "label": "Info text"
      },
      {
        "type": "text",
        "id": "button_text",
        "label": "Button text"
      },
      {
        "type": "url",
        "id": "button_url",
        "label": "Button url"
      },
      {
        "type": "header",
        "content": "Desktop Padding"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 0
      },
      {
        "type": "header",
        "content": "Mobile Padding"
      },
      {
        "type": "range",
        "id": "mobile_padding_top",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 0
      },
      {
        "type": "range",
        "id": "mobile_padding_bottom",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 0
      }
  ],
  "presets": [
    {
      "name": "Availability section"
    }
  ]
}
{% endschema %}
