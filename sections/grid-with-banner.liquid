{{ 'grid-with-banner.css' | asset_url | stylesheet_tag }}
{% style %}
    /*====== section padding ========*/
    #section--{{ section.id }} {
       padding-top: {{ section.settings.padding_top }}px;
       padding-bottom: {{ section.settings.padding_bottom }}px;

     }

     @media screen and (max-width: 767px) {
       #section--{{ section.id }} {
         padding-top: {{ section.settings.mobile_padding_top }}px;
         padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
       }
     }
  #collection--{{ section.id }}{
    background:{{ section.settings.collection_bg_color}};
  }
  #collection--{{ section.id }} .section_title,
  #collection--{{ section.id }} .section_info_text{
    color:{{ section.settings.collection_text_color}};
  }

  #singlepro--{{ section.id }}{
    background:{{ section.settings.product_bg_color}};
  }
  #singlepro--{{ section.id }} .section_title,
  #singlepro--{{ section.id }} .section_info_text{
      color:{{ section.settings.product_text_color}};
  }
{% endstyle %}

<section id="section--{{ section.id }}" class="gwb_sec">
  <div class="container">
    <div class="gwb_sec_row">
      <div class="collection_grid_main" id="collection--{{ section.id }}">
        <div class="gwb_text">
          {% if section.settings.collection_section_heading != blank %}
            <h2 class="section_title">{{ section.settings.collection_section_heading }}</h2>
          {% endif %}
          {% if section.settings.collection_info_text != blank %}
            <div class="section_info_text">{{ section.settings.collection_info_text }}</div>
          {% endif %}
        </div>
        <div class="mobility-products-collection">
          {%- for product in section.settings['mobility-products-collection'].products limit: 3 -%}
            {% assign lazy_load = false %}
            {%- if forloop.index > 2 -%}
              {%- assign lazy_load = true -%}
            {%- endif -%}
            {% render 'card-product',
              card_product: product,
              media_aspect_ratio: section.settings.image_ratio,
              show_secondary_image: section.settings.show_secondary_image,
              show_vendor: section.settings.show_vendor,
              show_rating: section.settings.show_rating,
              lazy_load: lazy_load,
              quick_add: section.settings.quick_add,
              section_id: section.id
            %}
            {% comment %}
              <div>
                {{ product.price | money }}
                {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}
                {% assign class = 'img-fluid' %}
                {%- capture sizes -%}
                  (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px,
                  (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)
                {%- endcapture -%}
                {{
                  product
                  | image_url: width: 1500
                  | image_tag: sizes: sizes, widths: widths, class: class
                }}
                {{ product.title }}
                {{ product.metafields.custom.product_subtitle }}
              </div>
            {% endcomment %}
          {%- endfor -%}
        </div>
        <div class="gwb_btn_wrapper">
          {% if section.settings.collection_button_text != blank %}
            <a class="main_btn" href="#">{{ section.settings.collection_button_text }}</a>
          {% endif %}
        </div>
      </div>
      <div class="product_banner_main" id="singlepro--{{ section.id }}">
        <div class="gwb_text">
          {% if section.settings.product_section_heading != blank %}
            <h2 class="section_title">{{ section.settings.product_section_heading }}</h2>
          {% endif %}
          {% if section.settings.product_info_text != blank %}
            <div class="section_info_text">{{ section.settings.product_info_text }}</div>
          {% endif %}
        </div>
        <div class="banner_product_wrapper">
          {% if section.settings['single-products-collection'] != blank %}
            <div class="product_wrapper">
              {% assign product = section.settings['single-products-collection'] %}
              <div class="pro_price">{{ product.price | money }}</div>
              {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}
              {% assign class = 'img-fluid' %}
              {%- capture sizes -%}
                  (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px,
                  (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)
                {%- endcapture -%}
              {{ product | image_url: width: 1500 | image_tag: sizes: sizes, widths: widths, class: class }}
              <div class="pro_title">{{ product.title }}</div>
              <div class="pro_text">{{ product.description | truncatewords: 12, '' }}</div>
            </div>
          {% endif %}
          <div class="gwb_btn_wrapper">
            {% if section.settings.Products_button_text != blank %}
              <a class="main_btn" href="#">{{ section.settings.Products_button_text }}</a>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
  "name": "Grid with banner section",
  "settings": [
      {
        "type": "color_background",
        "id": "collection_bg_color",
        "label": "Collection bg color"
      },
      {
        "type": "color_background",
        "id": "collection_text_color",
        "label": "Collection text color"
      },
      {
        "type": "text",
        "id": "collection_section_heading",
        "label": "Collection heading"
      },
      {
        "type": "richtext",
        "id": "collection_info_text",
        "label": "Collection info text"
      },
      {
        "type": "collection",
        "id": "mobility-products-collection",
        "label": "Mobility Products Collection"
      },
      {
        "type": "text",
        "id": "collection_button_text",
        "label": "Button text"
      },
      //============ Single product
      {
        "type": "header",
        "content": "Product details"
      },
       {
        "type": "color_background",
        "id": "product_bg_color",
        "label": "Collection bg color"
      },
      {
        "type": "color_background",
        "id": "product_text_color",
        "label": "Collection text color"
      },
      {
        "type": "text",
        "id": "product_section_heading",
        "label": "Banner heading"
      },
      {
        "type": "richtext",
        "id": "product_info_text",
        "label": "Banner text"
      },
      {
        "type": "product",
        "id": "single-products-collection",
        "label": "Select Product"
      },
      {
        "type": "text",
        "id": "Products_button_text",
        "label": "Button text"
      },
      {
        "type": "header",
        "content": "Desktop Padding"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 0
      },
      {
        "type": "header",
        "content": "Mobile Padding"
      },
      {
        "type": "range",
        "id": "mobile_padding_top",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 0
      },
      {
        "type": "range",
        "id": "mobile_padding_bottom",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 0
      }
  ],
  "presets": [
    {
      "name": "Grid with banner section"
    }
  ]
}
{% endschema %}
