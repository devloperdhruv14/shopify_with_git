{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="contact-section">
  <div class="contact container section-{{ section.id }}-padding">
    <div class="contact-heading-block">
      {% if section.settings.title != blank %}
        <h2 class="title title-wrapper--no-top-margin inline-richtext{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.title }}
        </h2>
      {% endif %}
      {% if section.settings.subtitle != blank %}
        <div class="title-subtitle-block{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">{{ section.settings.subtitle }}</div>
      {% endif %}
    </div>

    <div class="tab-contact-form-block row no-gutters">
      <div class="custom-tab-form custom-customer-form active" onclick="openTab(event, 'customer-form')"><a href="javascript:void(0)" class="custom-tab-link">I am a customer</a></div>
      <div class="custom-tab-form custom-professional-form" onclick="openTab(event, 'professional-form')"><a href="javascript:void(0)" class="custom-tab-link">I am a medical professional</a></div>
    </div>
    
    {%- liquid
      assign contact_form_class = 'isolate'
      if settings.animations_reveal_on_scroll
        assign contact_form_class = 'isolate scroll-trigger animate--slide-in'
      endif
    -%}
    <div class="tab-contact-form active customer-form-block" id="customer-form">
      {%- form 'contact', id: 'ContactForm', class: contact_form_class -%}
        {%- if form.posted_successfully? -%}
          <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
            {{- 'icon-success.svg' | inline_asset_content -}}
            {{ 'templates.contact.form.post_success' | t }}
          </h2>
        {%- elsif form.errors -%}
          <div class="form__message">
            <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
              {{- 'icon-error.svg' | inline_asset_content -}}
              {{ 'templates.contact.form.error_heading' | t }}
            </h2>
          </div>
          <ul class="form-status-list caption-large" role="list">
            <li>
              <a href="#ContactForm-email" class="link">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </a>
            </li>
          </ul>
        {%- endif -%}
        <div class="contact__fields">
          <div class="fields-block">
            <label class="field__label" for="ContactForm-name">Your name*</label>
            <input
              class="field__input"
              autocomplete="name"
              type="text" required
              id="ContactForm-name"
              name="contact[{{ 'templates.contact.form.name' | t }}]"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              placeholder="e.g. Lionel Quataert"
            >
          </div>
          <div class="fields-block field--with-error">
            <label class="field__label" for="ContactForm-email">
              Your email*</label>
            <input
              autocomplete="email"
              type="email"
              id="ContactForm-email"
              class="field__input"
              name="contact[email]"
              spellcheck="false"
              autocapitalize="off" required
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              aria-required="true"
              {% if form.errors contains 'email' %}
                aria-invalid="true"
                aria-describedby="ContactForm-email-error"
              {% endif %}
              placeholder="e.g. lionel@gmail.com"
            >
            {%- if form.errors contains 'email' -%}
              <small class="contact__field-error" id="ContactForm-email-error">
                <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                <span class="form__message">
                  <span class="svg-wrapper">
                    {{- 'icon-error.svg' | inline_asset_content -}}
                  </span>
                  {{- form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email -}}
                </span>
              </small>
            {%- endif -%}
          </div>
          <div class="fields-block">
            <label class="field__label" for="ContactForm-phone">Your phone*</label>
            <input
              type="tel"
              id="ContactForm-phone"
              class="field__input"
              autocomplete="tel"
              name="contact[{{ 'templates.contact.form.phone' | t }}]"
              pattern="[0-9\-]*" required
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
              placeholder="e.g. +33 7 80 96 47 74"
            >
          </div>
        </div>
        
        <div class="fields-block">
          <label class="field__label" for="ContactForm-phone">Are you contacting about an order?</label>
          <input
            type="tel"
            id="ContactForm-phone"
            class="field__input"
            autocomplete="tel"
            name="contact[Order Number]"
            pattern="[0-9\-]*"
            value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
            placeholder="Enter your order number here"
          >
        </div>
        
        <div class="fields-textarea-block fields-block">
          <label class="form__label field__label" for="ContactForm-body">
            Tell us how we can help?
          </label>
          <textarea
            rows="10"
            id="ContactForm-body"
            class="text-area field__input"
            name="contact[Question About Order]"
            placeholder="I have a question about..."
          >
            {{- form.body -}}
          </textarea>
        </div>
        <div class="contact__button">
          <button type="submit" class="contact-btn-w-100">Submit</button>
        </div>
      {%- endform -%}
    </div>

    <div class="tab-contact-form medical-professional-form-block" id="professional-form">
      {%- form 'contact', id: 'ContactForm_1', class: contact_form_class -%}
        {%- if form.posted_successfully? -%}
          <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
            {{- 'icon-success.svg' | inline_asset_content -}}
            {{ 'templates.contact.form.post_success' | t }}
          </h2>
        {%- elsif form.errors -%}
          <div class="form__message">
            <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
              {{- 'icon-error.svg' | inline_asset_content -}}
              {{ 'templates.contact.form.error_heading' | t }}
            </h2>
          </div>
          <ul class="form-status-list caption-large" role="list">
            <li>
              <a href="#ContactForm-email" class="link">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </a>
            </li>
          </ul>
        {%- endif -%}
        <div class="contact-method">
          <label class="field__label" for="contact-method">Who are you?</label>
          <div class="field__label-radio-flex">
            <div class="field__label-radio">
              <input type="radio" name="contact[I am]" value="Pharmacist" id="pharmacist" checked>
              <label class="radio-field__label" for="pharmacist">Pharmacist</label>
            </div>
            <div class="field__label-radio">
              <input type="radio" name="contact[I am]" value="Doctor" id="doctor">
              <label class="radio-field__label" for="doctor">Doctor</label>
            </div>
            <div class="field__label-radio">
              <input type="radio" name="contact[I am]" value="Physiotherapist" id="physiotherapist">
              <label class="radio-field__label" for="physiotherapist">Physiotherapist</label>
            </div>
          </div>
        </div>
        <div class="contact__fields">
          <div class="fields-block">
            <label class="field__label" for="ContactForm-name">Your name*</label>
            <input
              class="field__input"
              autocomplete="name"
              type="text" required
              id="ContactForm-name"
              name="contact[{{ 'templates.contact.form.name' | t }}]"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              placeholder="e.g. Lionel Quataert"
            >
          </div>
          <div class="fields-block field--with-error">
            <label class="field__label" for="ContactForm-email">
              Your email*</label>
            <input
              autocomplete="email"
              type="email"
              id="ContactForm-email"
              class="field__input"
              name="contact[email]"
              spellcheck="false"
              autocapitalize="off" required
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              aria-required="true"
              {% if form.errors contains 'email' %}
                aria-invalid="true"
                aria-describedby="ContactForm-email-error"
              {% endif %}
              placeholder="e.g. lionel@gmail.com"
            >
            {%- if form.errors contains 'email' -%}
              <small class="contact__field-error" id="ContactForm-email-error">
                <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                <span class="form__message">
                  <span class="svg-wrapper">
                    {{- 'icon-error.svg' | inline_asset_content -}}
                  </span>
                  {{- form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email -}}
                </span>
              </small>
            {%- endif -%}
          </div>
          <div class="fields-block">
            <label class="field__label" for="ContactForm-phone">Your phone*</label>
            <input
              type="tel"
              id="ContactForm-phone"
              class="field__input"
              autocomplete="tel"
              name="contact[{{ 'templates.contact.form.phone' | t }}]"
              pattern="[0-9\-]*" required
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
              placeholder="e.g. +33 7 80 96 47 74"
            >
          </div>
        </div>
        
        <div class="fields-textarea-block fields-block">
          <label class="form__label field__label" for="ContactForm-body">
            Tell us how we can help?
          </label>
          <textarea
            rows="10"
            id="ContactForm-body"
            class="text-area field__input"
            name="contact[Question About Order]"
            placeholder="I have a question about..."
          >
            {{- form.body -}}
          </textarea>
        </div>
        <div class="contact__button">
          <button type="submit" class="contact-btn-w-100">Submit</button>
        </div>
      {%- endform -%}
    </div>
    
  </div>
</div>

<script>
  function openTab(evt, tabName) {
    const tabContents = document.querySelectorAll('.tab-contact-form');
    tabContents.forEach(content => {
      content.classList.remove('active');
    });
    
    const tabButtons = document.querySelectorAll('.custom-tab-form');
    tabButtons.forEach(button => {
      button.classList.remove('active');
    });
    document.getElementById(tabName).classList.add('active');
    evt.currentTarget.classList.add('active');
  }
</script>

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sub Title"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top padding mobile",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding mobile",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact-form.presets.name"
    }
  ]
}
{% endschema %}
